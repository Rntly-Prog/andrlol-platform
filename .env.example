# Порт сервера
PORT=3000

# URL сайта (для возврата после оплаты)
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/andrlol_platform

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d

# ЮKassa (https://yookassa.ru)
# Тестовые ключи берутся в личном кабинете ЮKassa
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# SMTP для отправки кодов восстановления пароля
# Без SMTP коды выводятся в консоль сервера (удобно для разработки)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AndrLol <noreply@andrlol.ru>

NODE_ENV=development
