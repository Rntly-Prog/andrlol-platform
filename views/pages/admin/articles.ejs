<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../../partials/head') %>
</head>
<body>
  <%- include('../../partials/nav') %>
  <main class="container">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <%- include('../../partials/flash', { message: flash, type: 'success' }) %>
    <% } %>

    <h1 class="section-title">Управление статьями</h1>

    <%- include('../../partials/admin-nav') %>

    <!-- Форма создания -->
    <div class="admin-form">
      <h3>+ Новая статья</h3>
      <form action="/admin/articles" method="POST">
        <div class="form-group">
          <label>Заголовок</label>
          <input type="text" name="title" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Превью</label>
          <input type="text" name="preview" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Категория</label>
          <input type="text" name="category" class="form-control" required>
        </div>
        <div class="form-group">
          <label>Содержимое</label>
          <textarea name="content" class="form-control" required></textarea>
        </div>
        <div class="form-check">
          <input type="checkbox" name="isPremium" id="isPremium">
          <label for="isPremium">Премиум-статья</label>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:1rem">Создать</button>
      </form>
    </div>

    <!-- Список статей -->
    <table class="admin-table">
      <thead>
        <tr>
          <th>Заголовок</th>
          <th>Категория</th>
          <th>Premium</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% articles.forEach(article => { %>
          <tr>
            <td><%= article.title %></td>
            <td><%= article.category %></td>
            <td><%= article.isPremium ? '✓' : '—' %></td>
            <td>
              <details>
                <summary class="btn btn-sm btn-outline" style="cursor:pointer">Редактировать</summary>
                <form action="/admin/articles/<%= article.id %>" method="POST" style="margin-top:0.75rem;padding:1rem;background:var(--bg);border-radius:8px">
                  <div class="form-group">
                    <input type="text" name="title" class="form-control" value="<%= article.title %>" required>
                  </div>
                  <div class="form-group">
                    <input type="text" name="preview" class="form-control" value="<%= article.preview %>" required>
                  </div>
                  <div class="form-group">
                    <input type="text" name="category" class="form-control" value="<%= article.category %>" required>
                  </div>
                  <div class="form-group">
                    <textarea name="content" class="form-control" required><%= article.content %></textarea>
                  </div>
                  <div class="form-check">
                    <input type="checkbox" name="isPremium" <%= article.isPremium ? 'checked' : '' %>>
                    <label>Премиум</label>
                  </div>
                  <button type="submit" class="btn btn-sm btn-primary" style="margin-top:0.5rem">Сохранить</button>
                </form>
              </details>
              <form action="/admin/articles/<%= article.id %>/delete" method="POST" style="display:inline;margin-left:0.5rem">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить статью?')">Удалить</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
  <%- include('../../partials/footer') %>
</body>
</html>
