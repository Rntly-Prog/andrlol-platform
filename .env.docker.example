# Скопируйте в .env.docker и измените JWT_SECRET для продакшена
# docker compose --env-file .env.docker up -d --build

PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://andrlol:andrlol_secret@db:5432/andrlol_platform
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=production

YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

SMTP_HOST=
